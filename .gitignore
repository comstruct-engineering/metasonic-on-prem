*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / coverage
coverage/
.nyc_output/

# IDE and OS
.vs/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# User-specific tooling
*.user
*.userosscache
*.suo
*.sln.docstates
