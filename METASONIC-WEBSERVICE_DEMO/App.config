<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="ScanviewWebserviceBasicHTTP" />
                <binding name="ScanviewWebserviceMTOMBasicHTTP" messageEncoding="Mtom" />
            </basicHttpBinding>
            <wsHttpBinding>
                <binding name="ScanviewWebserviceBasicHTTP1" />
            </wsHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost/ScanviewWCF/ScanviewWebservice.svc"
                binding="basicHttpBinding" bindingConfiguration="ScanviewWebserviceBasicHTTP"
                contract="ScanviewWebservice.IScanviewWebservice" name="ScanviewWebserviceBasicHTTP" />
            <endpoint address="http://127.0.0.1:8089/ScanviewWebservice.svc/mtom"
                binding="basicHttpBinding" bindingConfiguration="ScanviewWebserviceMTOMBasicHTTP"
                contract="ScanviewWebservice.IScanviewWebservice" name="ScanviewWebserviceMTOMBasicHTTP" />
            <endpoint address="http://127.0.0.1:8089/ScanviewWebservice.svc/ws"
                binding="wsHttpBinding" bindingConfiguration="ScanviewWebserviceBasicHTTP1"
                contract="ScanviewWebservice.IScanviewWebservice" name="ScanviewWebserviceBasicHTTP1">
                <identity>
                    <dns value="localhost" />
                </identity>
            </endpoint>
        </client>
    </system.serviceModel>
</configuration>