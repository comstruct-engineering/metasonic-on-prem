# DocumentUploadPoC — environment variables
#
# Copy this file to `config.env`, fill in the values, and transpose them into `run.bat`
# (this project does not auto-load `config.env`; variables must be set in the process environment).
# Do not commit `config.env` or `run.bat` once they contain real secrets.

# -----------------------------------------------------------------------------
# Comstruct API (required for the worker)
# -----------------------------------------------------------------------------
COMSTRUCT_NEST_URL=https://api.comstruct.com
COMSTRUCT_API_PREFIX=v1
COMSTRUCT_API_KEY=

# Invoice queue filter and paging (optional; defaults match metasonic-cli-ts DMS worker)
# COMSTRUCT_DMS_QUEUE_STATUS=PRICE_CHECKING
# COMSTRUCT_DMS_LIMIT=50
# COMSTRUCT_DMS_UPDATED_AFTER_PARAM=updated_after
# COMSTRUCT_DMS_PATCH_PATH=/{prefix}/invoices/{id}/external-status
# COMSTRUCT_PDF_ANNOTATIONS=true

# -----------------------------------------------------------------------------
# MetaSonic DMS / Scanview (required for the worker)
# -----------------------------------------------------------------------------
METASONIC_ENDPOINT=http://YOUR_HOST:8089/ScanviewWebservice.svc
METASONIC_USER=
METASONIC_PASSWORD=
METASONIC_DB=

# Document class and field IDs (optional; empty means use app defaults / skip)
# METASONIC_DOC_CLASS_ID=1
# METASONIC_COMSTRUCT_INVOICE_QUALIFIER_ID=
# METASONIC_SEARCH_USER_FOLDER_ID=

# Correlation mode for linking Comstruct invoices to MetaSonic documents:
# omit or set to anything other than `id` → use invoice `external_id` (default)
# METASONIC_DMS_CORRELATION_KEY=id

# -----------------------------------------------------------------------------
# Worker behaviour (optional)
# -----------------------------------------------------------------------------
# DMS_WORKER_STATE_FILE=.dms-worker-state.json
# DMS_WORKER_INITIAL_UPDATED_AFTER=2020-01-01T00:00:00Z

# DMS_WORKER_DRY_RUN=true
# DMS_WORKER_ALLOW_CREATE_DMS_DOCUMENT=true

# After a successful PDF sync, optionally write qualifiers on the MetaSonic document:
# METASONIC_COMSTRUCT_SYNCED_QUALIFIER_ID=
# METASONIC_COMSTRUCT_URL_QUALIFIER_ID=
