# DocumentUploadPoC — Umgebungsvariablen (Vorlage)
#
# Kopieren Sie diese Datei nach `config.env` und tragen Sie Ihre Werte ein.
# `run.bat` lädt `config.env` automatisch, wenn die Datei im selben Ordner liegt
# (alternativ können die Variablen in `run.bat` oder als Windows-Systemumgebungsvariablen gesetzt werden).
# Committen Sie niemals `config.env` oder `run.bat` mit echten Zugangsdaten.

# -----------------------------------------------------------------------------
# Comstruct API (erforderlich für den Synchronisations-Worker)
# -----------------------------------------------------------------------------
COMSTRUCT_NEST_URL=https://api.comstruct.com
COMSTRUCT_API_PREFIX=v1
COMSTRUCT_API_KEY=

# Filter und Paginierung für den Rechnungsabruf (optional)
# COMSTRUCT_DMS_QUEUE_STATUS=PRICE_CHECKING
# COMSTRUCT_DMS_LIMIT=50
# COMSTRUCT_DMS_UPDATED_AFTER_PARAM=updated_after
# COMSTRUCT_DMS_PATCH_PATH=/{prefix}/invoices/{id}/external-status
# COMSTRUCT_PDF_ANNOTATIONS=true
# COMSTRUCT_PDF_OVERLAY=true

# -----------------------------------------------------------------------------
# MetaSonic DMS / Scanview (erforderlich für den Synchronisations-Worker)
# -----------------------------------------------------------------------------
METASONIC_ENDPOINT=http://IHR_METASONIC_HOST:8089/ScanviewWebservice.svc
METASONIC_USER=
METASONIC_PASSWORD=
METASONIC_DB=

# Dokumentklassen- und Qualifizierer-IDs (optional)
# METASONIC_DOC_CLASS_ID=1
# METASONIC_COMSTRUCT_INVOICE_QUALIFIER_ID=
# METASONIC_SEARCH_USER_FOLDER_ID=

# Korrelationsfeld zur Verknüpfung von Comstruct-Rechnungen mit MetaSonic-Dokumenten:
# Standard ist `external_id` (oder `id` setzen, um die Comstruct-Rechnungs-ID zu nutzen)
# METASONIC_DMS_CORRELATION_KEY=external_id

# -----------------------------------------------------------------------------
# Worker-Verhalten (optional)
# -----------------------------------------------------------------------------
# DMS_WORKER_STATE_FILE=.dms-worker-state.json
# DMS_WORKER_INITIAL_UPDATED_AFTER=2020-01-01T00:00:00Z

# Simulationsmodus ohne Schreibzugriffe (true / 1):
# DMS_WORKER_DRY_RUN=true
# DMS_WORKER_ALLOW_CREATE_DMS_DOCUMENT=true

# Optionale MetaSonic-Qualifizierer, die nach erfolgreichem PDF-Upload gesetzt werden:
# METASONIC_COMSTRUCT_SYNCED_QUALIFIER_ID=
# METASONIC_COMSTRUCT_URL_QUALIFIER_ID=
