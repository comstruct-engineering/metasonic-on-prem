# DocumentUploadPoC — Umgebungsvariablen (Vorlage)
#
# Kopieren Sie diese Datei nach `config.env` und tragen Sie Ihre Werte ein.
# `run.bat` lädt `config.env` automatisch, wenn die Datei im selben Ordner liegt
# (alternativ können die Variablen in `run.bat` oder als Windows-Systemumgebungsvariablen gesetzt werden).
# Committen Sie niemals `config.env` oder `run.bat` mit echten Zugangsdaten.

# -----------------------------------------------------------------------------
# Comstruct API (erforderlich für Rechnungs- und Stammdaten-Worker)
# -----------------------------------------------------------------------------
COMSTRUCT_NEST_URL=https://api.comstruct.com
COMSTRUCT_API_PREFIX=v1
COMSTRUCT_API_KEY=

# Filter und Paginierung für den Rechnungsabruf (optional)
# COMSTRUCT_DMS_QUEUE_STATUS=PRICE_CHECKING
# COMSTRUCT_DMS_LIMIT=50
# COMSTRUCT_DMS_UPDATED_AFTER_PARAM=updated_after
# COMSTRUCT_DMS_PATCH_PATH=/{prefix}/invoices/{id}/external-status
# COMSTRUCT_PDF_ANNOTATIONS=true
# COMSTRUCT_PDF_OVERLAY=true

# -----------------------------------------------------------------------------
# MetaSonic DMS / Scanview (erforderlich für den Rechnungs-Synchronisations-Worker)
# -----------------------------------------------------------------------------
METASONIC_ENDPOINT=http://IHR_METASONIC_HOST:8089/ScanviewWebservice.svc
METASONIC_USER=
METASONIC_PASSWORD=
METASONIC_DB=

# Dokumentklassen- und Qualifizierer-IDs (optional)
# METASONIC_DOC_CLASS_ID=1
# METASONIC_COMSTRUCT_INVOICE_QUALIFIER_ID=
# METASONIC_SEARCH_USER_FOLDER_ID=

# Korrelationsfeld zur Verknüpfung von Comstruct-Rechnungen mit MetaSonic-Dokumenten:
# Standard ist `external_id` (z. B. Druckjob-ID aus Comstruct; oder `id` setzen, um die Comstruct-Rechnungs-ID zu nutzen)
# METASONIC_DMS_CORRELATION_KEY=external_id

# -----------------------------------------------------------------------------
# Worker-Verhalten (optional)
# -----------------------------------------------------------------------------
# DMS_WORKER_STATE_FILE=.dms-worker-state.json
# DMS_WORKER_INITIAL_UPDATED_AFTER=2020-01-01T00:00:00Z

# Simulationsmodus ohne Schreibzugriffe (true / 1):
# DMS_WORKER_DRY_RUN=true

# Wenn Rechnungen direkt in Comstruct eingehen (z. B. per E-Mail-Weiterleitung) und
# in MetaSonic als neues Dokument (inkl. Druckjob-ID, PDF mit Stempel & Annotationen)
# angelegt werden sollen:
# DMS_WORKER_ALLOW_CREATE_DMS_DOCUMENT=true

# Optionale MetaSonic-Qualifizierer, die nach erfolgreichem PDF-Upload gesetzt werden:
# METASONIC_COMSTRUCT_SYNCED_QUALIFIER_ID=
# METASONIC_COMSTRUCT_URL_QUALIFIER_ID=

# -----------------------------------------------------------------------------
# BRZ Datenbankverbindung — Stammdaten-Synchronisation (run-masterdata.bat / test-db.bat)
# -----------------------------------------------------------------------------
# Datenbank-Treiber: `sqlserver` (Standard, ADO.NET SqlClient), `odbc` oder `oledb`
# BRZ_DB_PROVIDER=sqlserver
# BRZ_DB_TIMEOUT_SECONDS=60

# Connection-String für den lesenden BRZ-Datenbankbenutzer:
# Beispiel SQL Server: Server=BRZ-SERVER;Database=BRZ;User Id=comstruct_readonly;Password=GEHEIM;
# Beispiel ODBC:       DSN=BRZ_DSN;Uid=comstruct_readonly;Pwd=GEHEIM;
# BRZ_DB_CONNECTION_STRING=

# SQL-Abfragen für den Stammdaten-Abgleich (BRZ → Comstruct):
# Unterstützte Spalten-Aliase je Abfrage:
# - Lieferanten (POST /v1/suppliers): external_id (oder number/kreditor), title (oder name), country_code, legal_uid, address, city, zip, iban, active
# BRZ_SQL_SUPPLIERS_QUERY=SELECT KreditorNr AS external_id, Name AS title, 'DE' AS country_code, UStId AS legal_uid, Strasse AS address, Ort AS city, PLZ AS zip, IBAN AS iban FROM Kreditoren WHERE Aktiv = 1

# - Projekte / Kostenstellen (POST /v1/projects): project_number (oder kostenstelle), title (oder bezeichnung), external_id, legal_entity_number (oder betriebsnummer), address, city, zip, active
# BRZ_SQL_PROJECTS_QUERY=SELECT Kostenstelle AS project_number, Bezeichnung AS title, Kostenstelle AS external_id, Betriebsnummer AS legal_entity_number FROM Kostenstellen WHERE Aktiv = 1

# - Sachkonten (POST /v1/accounts): number (oder konto), title (oder bezeichnung), active
# BRZ_SQL_ACCOUNTS_QUERY=SELECT KontoNr AS number, Bezeichnung AS title FROM Sachkonten WHERE Aktiv = 1

# - Steuerkennzeichen (POST /v1/tax-codes): number (oder steuerkennzeichen), title (oder bezeichnung), rate (oder steuersatz), active
# BRZ_SQL_TAX_CODES_QUERY=SELECT Steuercode AS number, Bezeichnung AS title, Steuersatz AS rate FROM Steuerkennzeichen

# - Zahlungsbedingungen (POST /v1/payment-terms): number (oder code), title (oder bezeichnung), net_days, discount_days1, discount_rate1, discount_days2, discount_rate2, active
# BRZ_SQL_PAYMENT_TERMS_QUERY=SELECT Code AS number, Bezeichnung AS title, NettoTage AS net_days, Skonto1Tage AS discount_days1, Skonto1Prozent AS discount_rate1, 0 AS discount_days2, 0 AS discount_rate2 FROM Zahlungsbedingungen
