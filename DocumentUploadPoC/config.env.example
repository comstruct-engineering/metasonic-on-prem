# =============================================================================
# Comstruct <-> MetaSonic DMS Bidirectional Sync — Simple Configuration
# =============================================================================
# 1. Copy this file to `config.env`
# 2. Fill in the 5 required fields below
# 3. Run `run.bat` (or schedule `run.bat` every 5 minutes in Windows Task Scheduler)
# =============================================================================

# --- 1. Comstruct API (Required) ---
COMSTRUCT_API_KEY=
COMSTRUCT_NEST_URL=https://api.comstruct.com

# --- 2. MetaSonic DMS Connection (Required) ---
METASONIC_ENDPOINT=http://YOUR_METASONIC_HOST:8089/ScanviewWebservice.svc
METASONIC_USER=SVPADM
METASONIC_PASSWORD=
METASONIC_DB=BRZARCHIVMP

# --- 3. MetaSonic Document Classes ---
# Invoice document class in MetaSonic (scanned for new/updated invoices):
METASONIC_DOC_CLASS_ID=1
# Optional: Cost center / Project master-data class in MetaSonic (used to look up project names):
METASONIC_PROJECTS_DOC_CLASS_ID=89035003

# --- 4. MetaSonic Qualifier IDs (Optional — auto-detected by field name if left empty) ---
# METASONIC_QUAL_SUPPLIER_NAME=89900207
# METASONIC_QUAL_SUPPLIER_NUMBER=
# METASONIC_QUAL_PROJECT_NUMBER=
# METASONIC_QUAL_PROJECT_TITLE=
# METASONIC_QUAL_INVOICE_NUMBER=89900202
# METASONIC_QUAL_NET_AMOUNT=89900131
# METASONIC_QUAL_GROSS_AMOUNT=
# METASONIC_QUAL_INVOICE_DATE=

# Optional qualifiers written back to MetaSonic after stamped PDF upload:
# METASONIC_COMSTRUCT_SYNCED_QUALIFIER_ID=
# METASONIC_COMSTRUCT_URL_QUALIFIER_ID=

# --- 5. Sync Behavior & Watermark Persistence (Defaults work out-of-the-box) ---
# Status of checked invoices in Comstruct to write back to MetaSonic:
COMSTRUCT_DMS_QUEUE_STATUS=CHECKED
# External status set on the Comstruct invoice after successful write-back:
COMSTRUCT_DMS_PROCESSED_STATUS=SYNCED
# Embed Comstruct verification stamp (overlay) and annotations in the returned PDF:
COMSTRUCT_PDF_OVERLAY=true
COMSTRUCT_PDF_ANNOTATIONS=true
# Local state file where the last successful check timestamps are persisted:
# DMS_WORKER_STATE_FILE=.dms-worker-state.json
# Initial timestamp for the very first run (ISO-8601 UTC):
# DMS_WORKER_INITIAL_UPDATED_AFTER=2026-01-01T00:00:00Z
# Dry-run mode (true = preview actions without writing to Comstruct or MetaSonic):
# DMS_WORKER_DRY_RUN=true
