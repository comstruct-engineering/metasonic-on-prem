{
  "name": "metasonic-cli",
  "version": "1.0.0",
  "description": "CLI tool for updating Metasonic DMS document qualifiers",
  "main": "dist/index.js",
  "bin": {
    "metasonic-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "comstruct:smoke": "node dist/comstruct-smoke.js",
    "metasonic:smoke": "node dist/metasonic-smoke.js",
    "metasonic:mock": "node dist/mock/scanview-mock-server.js",
    "dms:worker": "node dist/dms-upload-worker.js",
    "prepublish": "npm run build"
  },
  "keywords": [
    "metasonic",
    "dms",
    "cli",
    "soap",
    "wcf"
  ],
  "author": "BRZ",
  "license": "UNLICENSED",
  "dependencies": {
    "commander": "^11.1.0",
    "soap": "^1.0.0",
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
